# Copy to .env and adjust. The app reads these at startup.

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=paper_trading

# --- Auth ---
# Use a long random string in production.
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_MINUTES=10080

# --- Prices ---
# auto  -> use Kite when the user has connected, else the mock provider
# mock  -> always simulated prices (no Kite needed)
# kite  -> require a live Kite connection
PRICE_PROVIDER=auto

# --- Kite Connect (optional; users connect their own in the app) ---
# A default app-level API key/secret can be set here so users only paste
# their request token. Leave blank to have users supply everything.
KITE_API_KEY=
KITE_API_SECRET=

# --- Business rules ---
MAX_DEPOSIT=1000000
